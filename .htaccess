Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# Never expose application code, configuration, data, tooling or Git metadata.
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(app|seed|storage|scripts|tests|docs|node_modules|dist)(/|$) - [F,L,NC]
RewriteRule ^(config[^/]*|README[^/]*|package[^/]*|informações)$ - [F,L,NC]
RewriteRule ^$ public/index.php [L]
RewriteRule ^index\.php$ public/index.php [L]
RewriteRule ^(admin|api|assets|uploads)(/.*)?$ public/$0 [L]
</IfModule>
<FilesMatch "(^\.|\.(json|log|ini|bak|env)$|^config.*\.php$)">
Require all denied
</FilesMatch>
